{
  "name": "arkhe",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "workspaces": [
    "packages/core",
    "packages/react",
    "packages/svelte",
    "apps/showcase"
  ],
  "scripts": {
    "build": "npm run build -w @arkhe/core && npm run build -w @arkhe/react && node .github/scripts/ascii-cwd.mjs npm run build -w @arkhe/svelte && npm run build -w showcase",
    "typecheck": "npm run typecheck --workspaces --if-present && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "npm run build -w showcase && playwright test",
    "health:check": "node .github/scripts/health-check.mjs",
    "publish:mirrors": "node .github/scripts/publish.mjs",
    "showcase": "npm run build && npm run preview -w showcase",
    "dev": "npm run dev -w showcase"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "sass": "1.107.0",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
